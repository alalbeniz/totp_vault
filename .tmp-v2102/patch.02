 const $ = (selector) => document.querySelector(selector);
 
+const COLOR_THEMES = new Set([
+  "1c485f", "08709c", "95cbc0", "d4c299", "777778", "42b8af", "cfdf9e", "ecd799", "fbb38a", "e77292"
+]);
+
+function normalizeColorTheme(theme) {
+  return COLOR_THEMES.has(theme) ? theme : "1c485f";
+}
+
+function applyColorTheme(theme) {
+  const normalized = normalizeColorTheme(theme);
+  document.documentElement.dataset.theme = normalized;
+  document.body?.setAttribute("data-theme", normalized);
+
+  document.querySelectorAll(".theme-swatch").forEach((button) => {
+    const selected = button.dataset.theme === normalized;
+    button.classList.toggle("selected", selected);
+    button.setAttribute("aria-checked", String(selected));
+    button.setAttribute("role", "radio");
+  });
+}
+
+async function saveColorTheme(theme) {
+  state.settings.colorTheme = normalizeColorTheme(theme);
+  applyColorTheme(state.settings.colorTheme);
+  await chrome.storage.local.set({ [STORAGE_SETTINGS]: state.settings });
+  await touchSession();
+  hideMessage("#settingsMessage");
+}
+
 document.addEventListener("DOMContentLoaded", init);
 
 async function init() {
